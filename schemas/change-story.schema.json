{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeh-change-lens.dev/schemas/change-story.schema.json",
  "title": "Chinese-first evidence-layered Change Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "story_id", "language", "status", "title",
    "analysis_digest", "revisions", "overview", "quick_view", "visual_map", "scenario_lens", "daily_brief", "change_canvas", "deep_dive", "lanes", "changes",
    "claims", "impacts", "limitations", "canonical_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.7.0" },
    "story_id": { "type": "string", "pattern": "^story:[a-f0-9]{24}$" },
    "language": { "const": "zh-CN" },
    "status": { "enum": ["FRESH", "PARTIAL"] },
    "title": { "type": "string", "minLength": 1 },
    "analysis_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "revisions": {
      "type": "object", "additionalProperties": false,
      "required": ["old", "new"],
      "properties": {
        "old": { "$ref": "common.schema.json#/$defs/revision_binding" },
        "new": { "$ref": "common.schema.json#/$defs/revision_binding" }
      }
    },
    "overview": {
      "type": "object", "additionalProperties": false,
      "required": ["headline_zh", "headline_en", "counts"],
      "properties": {
        "headline_zh": { "type": "string", "minLength": 1 },
        "headline_en": { "type": "string", "minLength": 1 },
        "counts": { "$ref": "#/$defs/counts" }
      }
    },
    "quick_view": { "$ref": "#/$defs/quick_view" },
    "visual_map": { "$ref": "#/$defs/visual_map" },
    "scenario_lens": { "$ref": "#/$defs/scenario_lens" },
    "daily_brief": { "$ref": "#/$defs/daily_brief" },
    "change_canvas": { "$ref": "#/$defs/change_canvas" },
    "deep_dive": { "$ref": "#/$defs/deep_dive" },
    "lanes": {
      "type": "object", "additionalProperties": false,
      "required": ["old", "new"],
      "properties": {
        "old": { "$ref": "#/$defs/lane" },
        "new": { "$ref": "#/$defs/lane" }
      }
    },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "impacts": { "type": "array", "items": { "$ref": "#/$defs/impact" } },
    "limitations": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "change_card": {
      "type": "object", "additionalProperties": false,
      "required": [
        "card_id", "area", "icon", "title_zh", "title_en", "summary_zh",
        "summary_en", "evidence_refs", "locations"
      ],
      "properties": {
        "card_id": { "type": "string", "pattern": "^card:[a-z-]+$" },
        "area": { "$ref": "#/$defs/area" },
        "icon": { "type": "string", "minLength": 1 },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "summary_zh": { "type": "string", "minLength": 1 },
        "summary_en": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_location" } }
      }
    },
    "flow_step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "step_id", "order", "area", "area_label_zh", "area_label_en", "label",
        "kind", "change", "confidence", "evidence_refs", "location"
      ],
      "properties": {
        "step_id": { "type": "string", "pattern": "^flow:[a-f0-9]{16}$" },
        "order": { "type": "integer", "minimum": 1 },
        "area": { "$ref": "#/$defs/area" },
        "area_label_zh": { "type": "string", "minLength": 1 },
        "area_label_en": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "location": { "$ref": "common.schema.json#/$defs/source_location" }
      }
    },
    "risk_card": {
      "type": "object", "additionalProperties": false,
      "required": [
        "risk_id", "level", "title_zh", "title_en", "description_zh",
        "description_en", "evidence_refs"
      ],
      "properties": {
        "risk_id": { "type": "string", "pattern": "^risk:[a-z-]+$" },
        "level": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "description_zh": { "type": "string", "minLength": 1 },
        "description_en": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "quick_view": {
      "type": "object", "additionalProperties": false,
      "required": [
        "summary_zh", "summary_en", "analogy_zh", "analogy_en", "primary_topic",
        "change_cards", "old_flow", "new_flow", "impact_summary_zh", "impact_summary_en",
        "risk_cards"
      ],
      "properties": {
        "summary_zh": { "type": "string", "minLength": 1 },
        "summary_en": { "type": "string", "minLength": 1 },
        "analogy_zh": { "type": "string", "minLength": 1 },
        "analogy_en": { "type": "string", "minLength": 1 },
        "primary_topic": { "type": "string", "minLength": 1 },
        "change_cards": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/change_card" } },
        "old_flow": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/flow_step" } },
        "new_flow": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/flow_step" } },
        "impact_summary_zh": { "type": "string", "minLength": 1 },
        "impact_summary_en": { "type": "string", "minLength": 1 },
        "risk_cards": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/risk_card" } }
      }
    },
    "visual_item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_id", "role", "label_zh", "label_en", "change", "confidence",
        "evidence_refs", "locations"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^visual:[a-f0-9]{16}$" },
        "role": { "enum": ["BEFORE", "CHANGE", "AFTER"] },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "change": {
          "enum": ["ADDED", "REMOVED", "UPDATED", "MOVED", "RENAMED", "RENAMED_AND_MOVED", "CONTEXT"]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "locations": {
          "type": "array", "maxItems": 6,
          "items": { "$ref": "common.schema.json#/$defs/source_location" }
        }
      }
    },
    "visual_map": {
      "type": "object", "additionalProperties": false,
      "required": [
        "change_shape", "relationship_mode", "headline_zh", "headline_en",
        "before_label_zh", "change_label_zh", "after_label_zh",
        "before_label_en", "change_label_en", "after_label_en",
        "before", "changes", "after", "relationship_note_zh", "relationship_note_en",
        "impact_zh", "impact_en", "risk_zh", "risk_en"
      ],
      "properties": {
        "change_shape": {
          "enum": ["MODIFIED", "ADDED", "REMOVED", "TEST_ONLY", "CONFIG_PROTOCOL", "PARALLEL"]
        },
        "relationship_mode": { "enum": ["VERIFIED_FLOW", "PARALLEL_FACTS"] },
        "headline_zh": { "type": "string", "minLength": 1 },
        "headline_en": { "type": "string", "minLength": 1 },
        "before_label_zh": { "type": "string", "minLength": 1 },
        "change_label_zh": { "type": "string", "minLength": 1 },
        "after_label_zh": { "type": "string", "minLength": 1 },
        "before_label_en": { "type": "string", "minLength": 1 },
        "change_label_en": { "type": "string", "minLength": 1 },
        "after_label_en": { "type": "string", "minLength": 1 },
        "before": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/visual_item" } },
        "changes": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/visual_item" } },
        "after": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/visual_item" } },
        "relationship_note_zh": { "type": "string", "minLength": 1 },
        "relationship_note_en": { "type": "string", "minLength": 1 },
        "impact_zh": { "type": "string", "minLength": 1 },
        "impact_en": { "type": "string", "minLength": 1 },
        "risk_zh": { "type": "string", "minLength": 1 },
        "risk_en": { "type": "string", "minLength": 1 }
      }
    },
    "scenario_item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_id", "role", "business_label_zh", "business_label_en", "technical_label",
        "area", "change", "confidence", "evidence_refs", "location"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" },
        "role": { "enum": ["BEFORE", "AFTER"] },
        "business_label_zh": { "type": "string", "minLength": 1 },
        "business_label_en": { "type": "string", "minLength": 1 },
        "technical_label": { "type": "string", "minLength": 1 },
        "area": { "$ref": "#/$defs/area" },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "location": { "$ref": "common.schema.json#/$defs/source_location" }
      }
    },
    "scenario_relationship": {
      "type": "object", "additionalProperties": false,
      "required": [
        "edge_id", "source_item_id", "target_item_id", "relation", "relation_zh",
        "change", "confidence", "evidence_refs"
      ],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "source_item_id": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" },
        "target_item_id": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" },
        "relation": { "type": "string", "minLength": 1 },
        "relation_zh": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scenario_id", "order", "icon", "title_zh", "title_en", "question_zh", "question_en",
        "answer_zh", "answer_en", "change_shape", "relationship_mode", "before", "after", "relationships", "evidence_refs"
      ],
      "properties": {
        "scenario_id": { "type": "string", "pattern": "^scenario:[a-z-]+$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "icon": { "type": "string", "minLength": 1 },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "question_zh": { "type": "string", "minLength": 1 },
        "question_en": { "type": "string", "minLength": 1 },
        "answer_zh": { "type": "string", "minLength": 1 },
        "answer_en": { "type": "string", "minLength": 1 },
        "change_shape": { "enum": ["MODIFIED", "ADDED", "REMOVED", "PARALLEL"] },
        "relationship_mode": { "enum": ["VERIFIED_FLOW", "PARALLEL_FACTS"] },
        "before": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/scenario_item" } },
        "after": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/scenario_item" } },
        "relationships": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/scenario_relationship" } },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "scenario_lens": {
      "type": "object", "additionalProperties": false,
      "required": [
        "primary_scenario_id", "summary_zh", "summary_en", "outcome_zh", "outcome_en", "takeaways_zh", "takeaways_en",
        "scope_note_zh", "scope_note_en", "scenarios", "visual_map_shape"
      ],
      "properties": {
        "primary_scenario_id": { "type": "string", "pattern": "^scenario:[a-z-]+$" },
        "summary_zh": { "type": "string", "minLength": 1 },
        "summary_en": { "type": "string", "minLength": 1 },
        "outcome_zh": { "type": "string", "minLength": 1 },
        "outcome_en": { "type": "string", "minLength": 1 },
        "takeaways_zh": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "takeaways_en": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "scope_note_zh": { "type": "string", "minLength": 1 },
        "scope_note_en": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/scenario" } },
        "visual_map_shape": { "enum": ["MODIFIED", "ADDED", "REMOVED", "TEST_ONLY", "CONFIG_PROTOCOL", "PARALLEL"] }
      }
    },
    "canvas_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["added_items", "removed_items", "changed_items"],
      "properties": {
        "added_items": { "type": "integer", "minimum": 0 },
        "removed_items": { "type": "integer", "minimum": 0 },
        "changed_items": { "type": "integer", "minimum": 0 }
      }
    },
    "change_capsule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "read_time_seconds", "verdict_zh", "before_zh", "after_zh",
        "impact_zh", "verify_zh"
      ],
      "properties": {
        "read_time_seconds": { "const": 10 },
        "verdict_zh": { "type": "string", "minLength": 1 },
        "before_zh": { "type": "string", "minLength": 1 },
        "after_zh": { "type": "string", "minLength": 1 },
        "impact_zh": { "type": "string", "minLength": 1 },
        "verify_zh": { "type": "string", "minLength": 1 }
      }
    },
    "verification_step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "step_id", "order", "action_zh", "action_en", "success_zh",
        "success_en", "evidence_refs"
      ],
      "properties": {
        "step_id": { "type": "string", "pattern": "^mission-step:[1-3]$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "action_zh": { "type": "string", "minLength": 1 },
        "action_en": { "type": "string", "minLength": 1 },
        "success_zh": { "type": "string", "minLength": 1 },
        "success_en": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification_mission": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mission_id", "title_zh", "title_en", "goal_zh", "goal_en",
        "estimated_minutes", "state", "first_step_id", "steps",
        "completion_zh", "completion_en", "boundary_zh", "boundary_en"
      ],
      "properties": {
        "mission_id": { "type": "string", "pattern": "^verification-mission:[a-z-]+$" },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "goal_zh": { "type": "string", "minLength": 1 },
        "goal_en": { "type": "string", "minLength": 1 },
        "estimated_minutes": { "type": "integer", "minimum": 1, "maximum": 5 },
        "state": { "enum": ["SUGGESTED", "PARTIAL"] },
        "first_step_id": { "type": "string", "pattern": "^mission-step:1$" },
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "$ref": "#/$defs/verification_step" }
        },
        "completion_zh": { "type": "string", "minLength": 1 },
        "completion_en": { "type": "string", "minLength": 1 },
        "boundary_zh": { "type": "string", "minLength": 1 },
        "boundary_en": { "type": "string", "minLength": 1 }
      }
    },
    "canvas_chapter": {
      "type": "object", "additionalProperties": false,
      "required": [
        "chapter_id", "scenario_id", "order", "title_zh", "question_zh",
        "change_shape", "relationship_mode", "before_item_ids", "delta_item_ids",
        "after_item_ids", "relationship_ids", "default_focus_item_id", "summary",
        "boundary_note_zh"
      ],
      "properties": {
        "chapter_id": { "type": "string", "pattern": "^canvas-chapter:[a-z-]+$" },
        "scenario_id": { "type": "string", "pattern": "^scenario:[a-z-]+$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title_zh": { "type": "string", "minLength": 1 },
        "question_zh": { "type": "string", "minLength": 1 },
        "change_shape": { "enum": ["MODIFIED", "ADDED", "REMOVED", "PARALLEL"] },
        "relationship_mode": { "enum": ["VERIFIED_FLOW", "PARALLEL_FACTS"] },
        "before_item_ids": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" }
        },
        "delta_item_ids": {
          "type": "array", "maxItems": 7, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" }
        },
        "after_item_ids": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^scenario-item:[a-f0-9]{16}$" }
        },
        "relationship_ids": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "default_focus_item_id": {
          "type": ["string", "null"],
          "pattern": "^scenario-item:[a-f0-9]{16}$"
        },
        "summary": { "$ref": "#/$defs/canvas_summary" },
        "boundary_note_zh": { "type": "string", "minLength": 1 }
      }
    },
    "change_canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["default_view", "primary_chapter_id", "summary", "capsule", "verification_mission", "partial_note_zh", "chapters"],
      "properties": {
        "default_view": { "const": "DELTA" },
        "primary_chapter_id": { "type": "string", "pattern": "^canvas-chapter:[a-z-]+$" },
        "summary": { "$ref": "#/$defs/canvas_summary" },
        "capsule": { "$ref": "#/$defs/change_capsule" },
        "verification_mission": { "$ref": "#/$defs/verification_mission" },
        "partial_note_zh": { "type": "string", "minLength": 1 },
        "chapters": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": { "$ref": "#/$defs/canvas_chapter" }
        }
      }
    },
    "daily_check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "kind", "action_zh", "action_en", "evidence_refs"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^daily-check:[a-z-]+$" },
        "kind": { "enum": ["PRIMARY_BEHAVIOR", "SECONDARY_BEHAVIOR", "RELATIONSHIP_PATH", "EVIDENCE_BOUNDARY", "REGRESSION"] },
        "action_zh": { "type": "string", "minLength": 1 },
        "action_en": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "daily_brief": {
      "type": "object", "additionalProperties": false,
      "required": [
        "question_zh", "question_en", "what_changed_zh", "what_changed_en",
        "why_it_matters_zh", "why_it_matters_en", "confidence_note_zh", "confidence_note_en",
        "primary_scenario_id", "change_shape", "checks"
      ],
      "properties": {
        "question_zh": { "type": "string", "minLength": 1 },
        "question_en": { "type": "string", "minLength": 1 },
        "what_changed_zh": { "type": "string", "minLength": 1 },
        "what_changed_en": { "type": "string", "minLength": 1 },
        "why_it_matters_zh": { "type": "string", "minLength": 1 },
        "why_it_matters_en": { "type": "string", "minLength": 1 },
        "confidence_note_zh": { "type": "string", "minLength": 1 },
        "confidence_note_en": { "type": "string", "minLength": 1 },
        "primary_scenario_id": { "type": "string", "pattern": "^scenario:[a-z-]+$" },
        "change_shape": { "enum": ["MODIFIED", "ADDED", "REMOVED", "PARALLEL"] },
        "checks": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/daily_check" } }
      }
    },
    "stage_relationship": {
      "type": "object", "additionalProperties": false,
      "required": [
        "edge_id", "source_label", "target_label", "relation", "relation_zh",
        "change", "confidence"
      ],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "source_label": { "type": "string", "minLength": 1 },
        "target_label": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "relation_zh": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "stage_id", "order", "area", "icon", "title_zh", "title_en", "summary_zh",
        "summary_en", "items", "relationships"
      ],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^stage:[a-z-]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "area": { "$ref": "#/$defs/area" },
        "icon": { "type": "string", "minLength": 1 },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "summary_zh": { "type": "string", "minLength": 1 },
        "summary_en": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/story_node" } },
        "relationships": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/stage_relationship" } }
      }
    },
    "decision_point": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision_id", "context", "condition", "statement_zh", "statement_en",
        "relation", "confidence", "evidence_refs", "location"
      ],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^decision:[a-f0-9]{16}$" },
        "context": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "statement_zh": { "type": "string", "minLength": 1 },
        "statement_en": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "location": { "$ref": "common.schema.json#/$defs/source_location" }
      }
    },
    "deep_dive": {
      "type": "object", "additionalProperties": false,
      "required": [
        "method_note_zh", "method_note_en", "strategy_summary_zh", "strategy_summary_en",
        "stages", "decision_points", "evidence_summary_zh", "evidence_summary_en"
      ],
      "properties": {
        "method_note_zh": { "type": "string", "minLength": 1 },
        "method_note_en": { "type": "string", "minLength": 1 },
        "strategy_summary_zh": { "type": "string", "minLength": 1 },
        "strategy_summary_en": { "type": "string", "minLength": 1 },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "decision_points": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/decision_point" } },
        "evidence_summary_zh": { "type": "string", "minLength": 1 },
        "evidence_summary_en": { "type": "string", "minLength": 1 }
      }
    },
    "area": {
      "enum": ["CONFIGURATION", "SERVER", "PROTOCOL", "EDITOR", "CLIENT", "RUNTIME", "TEST", "GENERATED"]
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "old_nodes", "new_nodes", "mapped_nodes", "added_nodes", "removed_nodes",
        "updated_node_pairs", "moved_node_pairs", "added_edges", "removed_edges",
        "unchanged_edge_pairs"
      ],
      "properties": {
        "old_nodes": { "type": "integer", "minimum": 0 },
        "new_nodes": { "type": "integer", "minimum": 0 },
        "mapped_nodes": { "type": "integer", "minimum": 0 },
        "added_nodes": { "type": "integer", "minimum": 0 },
        "removed_nodes": { "type": "integer", "minimum": 0 },
        "updated_node_pairs": { "type": "integer", "minimum": 0 },
        "moved_node_pairs": { "type": "integer", "minimum": 0 },
        "added_edges": { "type": "integer", "minimum": 0 },
        "removed_edges": { "type": "integer", "minimum": 0 },
        "unchanged_edge_pairs": { "type": "integer", "minimum": 0 }
      }
    },
    "story_node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "label", "kind", "change", "location", "confidence"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "location": { "$ref": "common.schema.json#/$defs/source_location" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    },
    "story_relation": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "relation", "relation_zh", "change", "confidence"],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "relation_zh": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": [
        "edge_id", "source", "target", "relation", "relation_zh", "change", "confidence"
      ],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/story_node" },
        "target": { "$ref": "#/$defs/story_node" },
        "relation": { "type": "string", "minLength": 1 },
        "relation_zh": { "type": "string", "minLength": 1 },
        "change": { "$ref": "common.schema.json#/$defs/change_kind" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    },
    "chain": {
      "type": "object", "additionalProperties": false,
      "required": ["chain_id", "nodes", "relations"],
      "properties": {
        "chain_id": { "type": "string", "pattern": "^chain:(?:old|new):[a-f0-9]{16}$" },
        "nodes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/story_node" } },
        "relations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/story_relation" } }
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "label_zh", "label_en", "chains", "relationships"],
      "properties": {
        "role": { "enum": ["OLD", "NEW"] },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": [
        "change_id", "kind", "subject_zh", "subject_en", "confidence",
        "evidence_refs", "locations"
      ],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ADDED", "REMOVED", "UPDATED", "MOVED", "RENAMED", "RENAMED_AND_MOVED"] },
        "subject_zh": { "type": "string", "minLength": 1 },
        "subject_en": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_location" } }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "layer", "statement_zh", "statement_en", "confidence", "evidence_refs"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["CODE_FACT", "SOURCE_EVIDENCE", "INTENT_INFERENCE"] },
        "statement_zh": { "type": "string", "minLength": 1 },
        "statement_en": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["impact_id", "label", "kind", "change", "location", "evidence_refs"],
      "properties": {
        "impact_id": { "type": "string", "pattern": "^impact:[a-f0-9]{16}$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["STATE", "EVENT", "TYPE", "UNKNOWN_TARGET"] },
        "change": { "enum": ["ADDED", "REMOVED"] },
        "location": { "$ref": "common.schema.json#/$defs/source_location" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
