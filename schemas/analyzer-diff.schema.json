{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeh-change-lens.dev/schemas/analyzer-diff.schema.json",
  "title": "Deterministic OLD/NEW analyzer graph diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "old_request_id", "new_request_id", "source_status",
    "nodes", "edges", "mappings", "summary", "limitations", "canonical_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["COMPLETE", "PARTIAL"] },
    "old_request_id": { "type": "string", "minLength": 1 },
    "new_request_id": { "type": "string", "minLength": 1 },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old", "new"],
      "properties": {
        "old": { "enum": ["COMPLETE", "PARTIAL"] },
        "new": { "enum": ["COMPLETE", "PARTIAL"] }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "explain-bundle.schema.json#/$defs/graph_node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "explain-bundle.schema.json#/$defs/graph_edge" }
    },
    "mappings": {
      "type": "array",
      "items": { "$ref": "explain-bundle.schema.json#/$defs/node_mapping" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_nodes", "new_nodes", "mapped_nodes", "added_nodes", "removed_nodes",
        "updated_node_pairs", "moved_node_pairs", "added_edges", "removed_edges",
        "unchanged_edge_pairs"
      ],
      "properties": {
        "old_nodes": { "type": "integer", "minimum": 0 },
        "new_nodes": { "type": "integer", "minimum": 0 },
        "mapped_nodes": { "type": "integer", "minimum": 0 },
        "added_nodes": { "type": "integer", "minimum": 0 },
        "removed_nodes": { "type": "integer", "minimum": 0 },
        "updated_node_pairs": { "type": "integer", "minimum": 0 },
        "moved_node_pairs": { "type": "integer", "minimum": 0 },
        "added_edges": { "type": "integer", "minimum": 0 },
        "removed_edges": { "type": "integer", "minimum": 0 },
        "unchanged_edge_pairs": { "type": "integer", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
